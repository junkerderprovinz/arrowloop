<?xml version="1.0" encoding="utf-8"?>
<!--
  Only what Android itself shows: the notification and its channels.
  Everything read inside the app comes from React Native.

  Not strings.xml, because `expo prebuild` generates one of that name for the
  app name and the scheme, and two files of one name in a folder overwrite
  each other.

  Every placeholder must match values-de/. `getString` fills by position, so a
  translation with fewer placeholders silently drops the remaining arguments.
  android/tools/check_strings.py is the guard.
-->
<resources>
    <!--
      One channel per thing the app can say, so Android's own notification
      page has more than a single switch on it: it is working, it finished, it
      failed. A fourth channel would be a switch with nothing behind it.
    -->
    <string name="channel_engine">Engine</string>
    <string name="channel_engine_why">Shown while ArrowLoop is syncing in the background. Silent.</string>

    <string name="channel_done">Finished runs</string>
    <string name="channel_done_why">What a scheduled run copied, moved or put in the bin. Only when something changed.</string>

    <string name="channel_failed">Failed runs</string>
    <string name="channel_failed_why">A scheduled run that did not finish, and why. A sync that fails quietly is worse than one that fails loudly.</string>

    <string name="notify_running">ArrowLoop is running</string>
    <string name="notify_running_why">Ready to sync, and able to keep going while the screen is off.</string>
    <string name="notify_stop">Stop</string>

    <string name="notify_done">Sync finished</string>
    <!-- Four numbers in this order: copied, moved, binned, conflicts. -->
    <string name="notify_done_what">%1$d copied, %2$d moved, %3$d binned, %4$d conflicts</string>
    <string name="notify_failed">Sync failed</string>
    <!--
      The one failure this app authors itself, and so the one it can say in
      the phone's language; every other reason under a failed sync is a
      sentence the engine composed in Go and arrives in English.

      Said plainly rather than as a timeout: after thirty seconds "it was
      slow" is not the explanation, and either the engine is missing from this
      build or it could not start.
    -->
    <string name="notify_failed_no_engine">The engine did not start. Open ArrowLoop once and check the engine card.</string>
</resources>
