{
  "bwlimit": "08:00,512k 19:00,off",
  "parallelJobs": 1,
  "notify": {
    "matrix": {
      "homeserver": "https://matrix.example.org",
      "room": "!abcdefghijklmnop:example.org",
      "token": "syt_put_an_access_token_here"
    },
    "onSuccess": false
  },
  "defaults": {
    "quietPeriod": "5s",
    "transfers": 4,
    "brakePercent": 50,
    "brakeFloor": 10
  },
  "excludeSets": {
    "junk": [
      "Thumbs.db",
      ".DS_Store",
      "**/.thumbnails/**"
    ],
    "buildOutput": [
      "node_modules/**",
      "target/**",
      "dist/**"
    ]
  },
  "jobs": [
    {
      "name": "photos",
      "left": "D:/Photos",
      "right": "sftp:backup/photos",
      "state": "state/photos.db",
      "schedule": "*/15 * * * *",
      "exclude": [
        "*.xmp"
      ],
      "excludeSets": [
        "junk"
      ],
      "emptyDirs": true,
      "transfers": 4,
      "watch": true,
      "watchSettle": "2s"
    },
    {
      "name": "documents",
      "left": "D:/Documents",
      "right": "s3:my-bucket/documents",
      "state": "state/documents.db",
      "schedule": "0 * * * *",
      "quietPeriod": "30s",
      "metadata": true,
      "firstRun": "left",
      "keepVersions": 5
    },
    {
      "name": "scratch",
      "left": "D:/Scratch",
      "right": "E:/ScratchMirror",
      "state": "state/scratch.db",
      "brakePercent": 0
    },
    {
      "name": "server-share",
      "left": "D:/Share",
      "right": "//nas/share",
      "state": "state/server-share.db",
      "schedule": "0 3 * * *",
      "reportOnly": true,
      "foldCase": true
    }
  ]
}
