{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "packageRules": [
    {
      "description": "The Expo SDK decides React, React Native and the native modules in mobile/; npx expo install --fix moves them with an SDK upgrade",
      "matchFileNames": [
        "mobile/package.json"
      ],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/**",
        "react",
        "react-dom",
        "@types/react",
        "react-native",
        "react-native-*",
        "@react-native/**",
        "@react-native-community/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "React Native's Android build expects JDK 17; on 25 the CMake step fails on restricted-method warnings",
      "matchFileNames": [
        ".github/workflows/mobile.yml"
      ],
      "matchDepNames": [
        "java-jdk"
      ],
      "allowedVersions": "17"
    },
    {
      "description": "modernc.org/libc moves in step with modernc.org/sqlite, which still requires v1; a v2 requirement would only sit unused next to it",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "modernc.org/libc"
      ],
      "allowedVersions": "<2"
    },
    {
      "description": "The compose file is for people to copy, so it follows the app's own latest tag instead of a digest that goes stale every build",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "junkerderprovinz/arrowloop"
      ],
      "enabled": false
    }
  ]
}
