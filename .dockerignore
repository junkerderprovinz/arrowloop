# The container workflow clones the full history for `git describe`, which would
# otherwise be sent to the daemon as build context the build never opens. A local
# web/node_modules would be copied over the one `npm ci` installs in the image,
# putting Windows or macOS binaries into a Linux build.

# The workflow computes the version stamp and passes it in as a build argument.
.git
.gitattributes
.gitignore

web/node_modules
web/dist
node_modules

desktop/build/bin
desktop/frontend/dist

*.exe
*.test

.github
docs
templates
scripts
*.md
LICENSE

smoke-config
.playwright-mcp
