<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine reaches cloud targets over the network. Nothing else here
         needs the internet, and the app talks to its OWN engine over loopback,
         which needs no permission at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keeping a sync alive while the screen is off is what a foreground
         service is FOR, and since Android 14 the type has to be declared
         alongside a permission that matches it. dataSync is the honest one:
         this moves files between two places on somebody's behalf. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The notification IS the foreground service on Android 13 and up:
         without the permission the service still runs and its notification is
         silently dropped, which leaves a sync going with nothing on screen
         saying so. Asked for at the point it is needed rather than at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A scheduled sync that stops existing when the phone is rebooted is a
         scheduled sync nobody can rely on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The broadest file permission Android has, and the only one that works
         for what this app is. Storage.kt carries the full reasoning; the short
         version is that the engine is its own POSIX process, which cannot
         reach the Storage Access Framework at all, and that SAF cannot set a
         modification time even from a process that can - DocumentsProvider's
         update() is final and throws. A two-way sync comparing on size and
         mtime has nothing to stand on there.

         Google permits this permission for the category this app is in
         ("Backup and restore apps"), and the Play listing has to say so. jdp
         chose this route on 2026-09-10 over binding the engine into the app
         process with gomobile, which would be a second build of the engine for
         one platform and would still not fix the mtime. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Below Android 10 there is no MANAGE_EXTERNAL_STORAGE and this is what
         grants the same reach, as an ordinary runtime permission. Capped at 28
         on purpose: from 29 it grants nothing useful, and a permission that
         asks for something it cannot deliver is worse than one that is absent.
         Android 10 itself is a genuine gap - see Storage.possible. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ArrowLoopApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArrowLoop"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is for 127.0.0.1 and nothing else, and the
             network security config below says exactly that: the loopback
             address may be plain HTTP, everything else may not. Without the
             config this flag would also permit plain HTTP to any server on the
             internet, which is not what is being asked for. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
