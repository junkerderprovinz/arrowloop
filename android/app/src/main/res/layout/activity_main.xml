<?xml version="1.0" encoding="utf-8"?>
<!--
  One of three is visible at a time: the waiting line, the interface, and the
  log if the engine never answered. The WebView starts hidden, so the first
  thing on screen is a sentence rather than a white rectangle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/waiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textColor="@color/ink_muted"
        android:textSize="14sp"
        android:text="@string/engine_starting" />

    <TextView
        android:id="@+id/trouble"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        android:visibility="gone" />

    <!--
      Drawn in Android views because it concerns a permission the engine cannot
      see, and has to be readable before the engine answers. It is not a gate:
      "Not now" hides it for the launch, and jobs inside the app's own folder
      work either way.
    -->
    <LinearLayout
        android:id="@+id/storage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@color/ground"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/storage_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/storage_title" />

        <TextView
            android:id="@+id/storage_why"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink_muted"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/storage_why" />

        <Button
            android:id="@+id/storage_grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/accent_ink"
            android:textAllCaps="false"
            android:text="@string/storage_grant" />

        <Button
            android:id="@+id/storage_later"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/surface3"
            android:textColor="@color/ink"
            android:textAllCaps="false"
            android:text="@string/storage_later" />

    </LinearLayout>

</FrameLayout>
