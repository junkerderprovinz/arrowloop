<?xml version="1.0" encoding="utf-8"?>
<!--
  GlimStone's carbon values as tokens.css sets them, so the window behind the
  WebView matches the interface and no rotation flashes the wrong ground. The
  surface and accent are for the storage panel, drawn in Android views.
-->
<resources>
    <color name="ground">#161616</color>
    <color name="ink">#f4f4f4</color>
    <color name="ink_muted">#8d8d8d</color>
    <color name="surface3">#525252</color>
    <color name="accent">#FCC419</color>
    <color name="accent_ink">#161616</color>

    <!-- The launcher masks this layer into a white rounded tile; a carbon ground
         would disappear into a dark home screen. -->
    <color name="ic_launcher_background">#ffffff</color>
</resources>
