# Build output. The last one is where scripts/build-windows.mjs puts the command
# line binary, so it lands in the working tree on every Windows build.
/arrowloop
/arrowloop.exe
/arrowloop-cli.exe

# Job state databases, never in the repo: they describe someone's real files
*.db
*.db-wal
*.db-shm

# The job file the tool writes for itself on a first start in an empty working
# directory. Running the interface once from the clone is enough to create it,
# and it is the file that ends up holding real paths and a Matrix access token,
# so it must never be committable by accident. The committed example next to it
# is arrowloop.example.json.
/arrowloop.json

# The frontend's own dependencies and build output.
web/node_modules/

# Keep the directory so `//go:embed all:dist` compiles before the
# Vite build exists; real build artefacts stay out of the repo.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# Everything scripts/desktop.mjs has Wails generate on every build: the Windows
# manifest, icon and version resource, the macOS Info.plist and icon, the
# installer's helper macros and the WebView2 bootstrapper it carries, and the
# build output. What is committed is what Wails cannot write for us: the logo,
# the build configuration and the installer script with the shortcut page.
desktop/build/*
!desktop/build/appicon.png
!desktop/build/config.yml
!desktop/build/windows/
desktop/build/windows/*
!desktop/build/windows/nsis/
desktop/build/windows/nsis/*
!desktop/build/windows/nsis/project.nsi
desktop/*.syso

# The stray binary a plain `go build ./...` drops in the module directory.
desktop/desktop
desktop/desktop.exe

# MkDocs build output; the Docs workflow builds it fresh.
/site/
