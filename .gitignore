# Build output
/arrowloop
/arrowloop.exe

# Job state databases, never in the repo: they describe someone's real files
*.db
*.db-wal
*.db-shm

# The frontend's own dependencies and build output.
web/node_modules/

# Keep the directory so `//go:embed all:dist` compiles before the
# Vite build exists; real build artefacts stay out of the repo.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# The Wails shell embeds its own copy of the interface, built into place by CI.
# The keep-file is what makes `//go:embed all:frontend/dist` compile before that.
!desktop/frontend/dist/
desktop/frontend/dist/*
!desktop/frontend/dist/.gitkeep

# Everything `wails build` generates for itself: the Windows manifest it writes
# from wails.json and the JavaScript bindings, all regenerated on every build.
# The application icon is the one exception and has to be committed: wails only
# draws its own default when `build/appicon.png` is missing, so leaving the
# whole folder out would ship the Wails logo as this product's.
desktop/build/*
!desktop/build/appicon.png
desktop/frontend/wailsjs/

# Wails build output, and the stray binary a plain `go build ./...` drops in
# the module directory.
desktop/build/bin/
desktop/desktop
desktop/desktop.exe

# MkDocs build output; the Docs workflow builds it fresh.
/site/
