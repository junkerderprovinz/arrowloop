# LF in the repository and in every checkout, Windows included.
* text=auto eol=lf

*.go  text eol=lf
*.yml text eol=lf
*.tsx text eol=lf
*.ts  text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf

# Linguist counts bytes, and the translation tables and the generated glyph file
# are data in .ts files that would make TypeScript the main language of a Go
# program. `linguist-generated=true` also folds the generated file away in a
# diff.
web/src/lib/locales/*.ts linguist-detectable=false
web/src/lib/i18n.ts linguist-detectable=false
web/src/components/glyphs.tsx linguist-generated=true
