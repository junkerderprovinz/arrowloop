***************************** WARNING *****************************
Do NOT edit this file directly, unless you REALLY know what you are doing !!


[profile_global]
appName=luckyBackup
appVersion=0.5
TotalTasks=4
ProfileDescription=Home backups

[email]
emailCommand=sendemail
emailArguments=-f %f -t %t -u %s -m %b -s %v
emailSubject=luckyBackup report
emailNever=0
emailError=1
emailSchedule=0
emailTLS=0
emailFrom=reeve@example.org
emailTo=reeve@example.org
emailSMTP=mail.example.org
emailBody=Profile: %p

[Task] - 0
Name=Documents
TypeDirContents=1
TypeDirName=0
TypeSync=0
Source=/home/reeve/Documents/
Destination=/mnt/backup/documents/
LastExecutionTime=20261101211500
LastExecutionErrors=0
ConnectRestore=
KeepSnapshots=3
Exclude=1
ExcludeFromFile=0
ExcludeFile=
ExcludeTemp=1
ExcludeCache=0
ExcludeBackup=0
ExcludeMount=0
ExcludeLostFound=0
ExcludeSystem=0
ExcludeTrash=1
ExcludeGVFS=0
ExcludeListItem=*.iso
ExcludeListItem=/build/
ExcludeListItem=node_modules/
Include=0
IncludeFromFile=0
IncludeModeNormal=1
IncludeFile=
Remote=0
RemoteModule=0
RemoteDestination=0
RemoteSource=0
RemoteSSH=0
RemoteHost=
RemoteUser=
RemotePassword=
RemoteSSHPassword=
RemoteSSHPasswordStr=
RemoteSSHOptions=
RemoteSSHPort=0
OptionsUpdate=1
OptionsDelete=1
OptionsRecurse=1
OptionsOwnership=0
OptionsSymlinks=1
OptionsPermissions=1
OptionsDevices=0
OptionsCVS=0
OptionsHardLinks=0
OptionsFATntfs=0
OptionsSuper=0
OptionsNumericIDs=0
OptionsRestorent=0
OptionsVss=0
LuckyBackupDir=/home/reeve/.luckyBackup/
VshadowDir=
RsyncCommand=rsync
SshCommand=ssh
DosdevCommand=
CygpathCommand=
TempPath=
ExecuteBeforeListItem=mount /mnt/backup
ExecuteBeforeListItemState=1
ByPassWarning=0
CloneWarning=1
RepeatOnFail=0
IncludeState=1
[Task_end] - 0

